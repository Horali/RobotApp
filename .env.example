# Copy to .env and fill in. .env is git-ignored: no secret ever goes into the repo.

# Chameleon (CustomBrowser) daemon. The robot reads a password here at the moment it types it.
# The token is in Chameleon's settings (it is the API bearer token the daemon generated).
CHAMELEON_API_URL=http://127.0.0.1:38100
CHAMELEON_TOKEN=

# adb and the phone
ADB_PATH=C:\Users\child\AppData\Local\Android\Sdk\platform-tools\adb.exe
PHONE_SERIAL=192.168.1.8:5555

# Optional: where data/ lives (robot.db, logs, screenshots). Default: the repo's data/.
# ROBOTAPP_DATA=
